# Copy to .env (git ignores it) and change what you need. `frun` reads .env from
# the directory you run it in, and from the directory your agent file lives in.
# Anything already exported in your shell wins over this file.

# ============ Secrets ============
# Hugging Face token, for gated or private models (frun models pull hf:...)
# HF_TOKEN=hf_...
# Only needed when the LLM is a hosted endpoint that requires a key
# OPENAI_API_KEY=sk-...

# ============ What to run ============
# An agent file: its prompt, models and turn settings (same as `frun up agent.py`)
# FUSION_AGENT=./agent.py
# Profile used when there's no agent file: development | production | hybrid
# FUSION_CONFIG=development
# Where models are downloaded and loaded from
# FUSION_MODEL_DIR=./models
# Download models the agent names but the machine doesn't have (1 by default)
# FUSION_AUTO_DOWNLOAD=1

# ============ Turn taking ============
# Silence before the agent answers, in milliseconds
# FUSION_TURN_WAIT_MS=500
# How long the caller must talk over the agent before it stops
# FUSION_INTERRUPT_AFTER_MS=300
# A turn detector model: a plugin name or module:Class
# FUSION_TURN_DETECTOR=my_package.turns:MyDetector

# ============ LLM from an OpenAI-compatible endpoint ============
# vLLM, llama-server, Ollama or a hosted API; all three are needed together
# FUSION_LLM_URL=http://localhost:8080/v1
# FUSION_LLM_MODEL=my-model
# Name of the variable holding that endpoint's key — never the key itself
# FUSION_LLM_API_KEY_ENV=OPENAI_API_KEY

# ============ Logs ============
# pretty (a terminal) | json (deployments and log collectors) | off
# FUSION_LOG_FORMAT=pretty
# debug | info | warning | error
# FUSION_LOG_LEVEL=info
# Write transcripts and replies into the logs (off by default)
# FUSION_LOG_CONTENT=0

# ============ frun talk ============
# FUSION_AEC=0 turns off echo cancellation, same as `frun talk --no-aec`
# FUSION_AEC=1
