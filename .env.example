# fusion-runtime Environment Configuration
# Copy to .env.local and modify as needed

# ============ Model Configuration ============
# STT Provider: faster_whisper, fire_red_asr, deepgram, gladia, openai_stt
FUSION_STT_PROVIDER=faster_whisper
FUSION_STT_MODEL=tiny.en
FUSION_STT_DEVICE=cuda
FUSION_STT_COMPUTE_TYPE=float16

# LLM Provider: llama_cpp, vllm, ollama, openai, anthropic
FUSION_LLM_PROVIDER=llama_cpp
FUSION_LLM_MODEL=Qwen2.5-7B-Instruct-Q4_K_M.gguf
FUSION_LLM_N_GPU_LAYERS=-1
FUSION_LLM_N_CTX=4096

# TTS Provider: kokoro, fire_red_tts, xtts, piper, elevenlabs, openai_tts, cartesia
FUSION_TTS_PROVIDER=kokoro
FUSION_TTS_MODEL=kokoro-v1.0.onnx
FUSION_TTS_VOICE=af_heart

# VAD Provider: silero, pvad, webrtc
FUSION_VAD_PROVIDER=silero
FUSION_VAD_THRESHOLD=0.5

# Turn Detection: punctuation, fire_red_eot
FUSION_TURN_DETECTOR=punctuation

# ============ Pipeline Configuration ============
FUSION_TARGET_LATENCY_MS=500
FUSION_ALLOW_CLOUD_FALLBACK=false
FUSION_ENABLE_BATCHING=true
FUSION_BATCH_TIMEOUT_MS=50
FUSION_MAX_BATCH_SIZE=8

# ============ API Keys (for cloud providers) ============
# Only needed if using cloud providers
# DEEPGRAM_API_KEY=
# GLADIA_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
# CARTESIA_API_KEY=

# ============ Model Paths ============
MODEL_DIR=/models

# ============ Server ============
HOST=0.0.0.0
PORT=8000
WORKERS=1